# Copie para .env.supabase e preencha somente neste computador/servidor.
# Para usar: $env:HELPDESK_ENV_FILE = (Resolve-Path .env.supabase).Path
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
SHARED_DATABASE=True
# Use a URI PostgreSQL do painel Connect, conexão direta ou Session pooler.
# Codifique caracteres especiais da senha na URI.
DATABASE_URL=
# Schema separado, não exposto pela API de dados do Supabase.
DATABASE_SCHEMA=helpdesk
JWT_EXPIRES_SECONDS=28800
STORAGE_S3_ENDPOINT=
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=helpdesk-anexos
# Na hospedagem do app: DEBUG=False, SECRET_KEY compartilhada e domínio real.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
